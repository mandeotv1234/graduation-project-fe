{
  "name": "graduation-project-fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "format": "prettier --write",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:debug": "dotenv -e .env.test -- playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:auth": "dotenv -e .env.test -- playwright test tests/01-auth.spec.ts",
    "test:e2e:exam-list": "dotenv -e .env.test -- playwright test tests/02-exam-list.spec.ts",
    "test:e2e:pre-exam": "dotenv -e .env.test -- playwright test tests/03-pre-exam.spec.ts",
    "test:e2e:interface": "dotenv -e .env.test -- playwright test tests/04-exam-interface.spec.ts",
    "test:e2e:draft": "dotenv -e .env.test -- playwright test tests/05-draft-save.spec.ts",
    "test:e2e:anti-cheat": "dotenv -e .env.test -- playwright test tests/06-anti-cheat.spec.ts",
    "test:e2e:submit": "dotenv -e .env.test -- playwright test tests/07-submit.spec.ts",
    "test:e2e:timer": "dotenv -e .env.test -- playwright test tests/08-timer-submit.spec.ts",
    "test:e2e:navigation": "dotenv -e .env.test -- playwright test tests/09-navigation.spec.ts",
    "test:e2e:results": "dotenv -e .env.test -- playwright test tests/10-results.spec.ts",
    "test:e2e:session": "dotenv -e .env.test -- playwright test tests/11-session.spec.ts",
    "test:e2e:security": "dotenv -e .env.test -- playwright test tests/12-security.spec.ts",
    "test:e2e:infra:up": "docker compose -f ../docker-compose.e2e.yml up -d --wait",
    "test:e2e:infra:down": "docker compose -f ../docker-compose.e2e.yml down -v"
  },
  "lint-staged": {
    "src/**/*.{ts,js,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
